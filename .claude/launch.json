{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dlife-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dlife-dev-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mock"
      ],
      "port": 3100
    },
    {
      "name": "talous-cms",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd \"$HOME/Documents/talous-cms\" && npm run dev"
      ],
      "port": 3200
    }
  ]
}
