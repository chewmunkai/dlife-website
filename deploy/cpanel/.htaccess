# dlife.com.my on the cPanel (LiteSpeed) server.
# Copied into the build by .github/workflows/deploy-cpanel.yml; the GitHub
# Pages preview never sees it. Makes this server answer the way Pages does.

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
RewriteEngine On

# One address: https, no www. AutoSSL's domain checks are left alone.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://dlife.com.my%{REQUEST_URI} [L,R=301]

# The deploy's own bookkeeping file is nobody's business.
RewriteRule ^\.ftp-deploy - [F,L]

# The Solutions hub was retired on 12 Oct 2026; its address goes to the
# homepage section that replaced it.
RewriteRule ^solutions/?$ /#needs [L,R=301,NE]

# /about/ -> /about (the export writes no index files inside folders).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [L,R=301]

# /about -> about.html (trailingSlash: false writes flat .html files).
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html

# Fingerprinted build files never change: cache them for a year. FilesMatch
# sees only file names, not paths, hence the flag set by a rewrite.
RewriteRule ^_next/static/ - [E=IMMUTABLE:1]
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
